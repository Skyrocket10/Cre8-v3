{
  "$schema": "node_modules/wrangler/config-schema.json",

  // One Worker: the editor, the API and published sites, all on one origin.
  //
  // The editor is a static Next export in `out/`. Cloudflare's asset router
  // serves anything that matches a file straight from the edge *without
  // invoking this Worker*, so the app itself still costs no invocations — the
  // handler only runs for /api/*, /s/* and genuine 404s.
  //
  // One origin is what removes three separate pieces of configuration: no
  // build-time API URL to bake in, no CORS allowlist to keep in step with the
  // deployment, and no SameSite=None cookies. See src/index.ts.
  //
  // `not_found_handling: "none"` is load-bearing. The other modes let the asset
  // router answer unmatched paths itself, which would swallow /api/* before the
  // handler ever saw it. "none" falls through to the Worker, which serves
  // out/404.html for anything it does not recognise.

  "name": "cre8",
  "main": "workers/src/index.ts",
  "compatibility_date": "2026-08-08",

  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cre8",
      "database_id": "0375dbbf-261d-40a6-9000-28e24a1d6d4e"
    }
  ],

  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "cre8-assets" },
    { "binding": "SITES", "bucket_name": "cre8-sites" }
  ],

  // hostname → project id, written here on publish and read by the sites
  // Worker. KV rather than D1 because it is read on the highest-volume path in
  // the system, and it keeps the sites Worker off the database entirely.
  "kv_namespaces": [{ "binding": "SITE_ROUTES", "id": "b02740d6a32f489dbdbe28d07c0302ec" }],

  // One instance per project: holds the live document, serialises edits and
  // fans out presence. See workers/src/room.ts.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ProjectRoom" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }],

  "vars": {
    // Only needed if you serve the editor from somewhere other than this
    // Worker. Same-origin requests need no entry here, and an empty list means
    // the API answers same-origin callers only.
    "ALLOWED_ORIGINS": "",

    // Set to "false" to close signups once your team has accounts.
    "ALLOW_SIGNUP": "true",

    // ── CHANGE THIS ───────────────────────────────────────────────────────
    // Apex for published sites. Must match the wildcard route in
    // workers/sites/wrangler.jsonc — these are the only two places it appears.
    //
    // Projects publish to <subdomain>.<PUBLIC_SITE_DOMAIN>. Leave it empty and
    // the whole mechanism switches off: no second Worker, and sites stay on
    // this one at /s/<projectId>/, sandboxed.
    "PUBLIC_SITE_DOMAIN": "cre8.app"
  }

  // `/s/<projectId>/` still works on this Worker whatever PUBLIC_SITE_DOMAIN
  // says. It is the fallback for a one-Worker deploy and for local dev, and it
  // is served with a sandbox CSP because on this origin it shares a domain with
  // the session. The sites Worker needs no such thing.
}
