{
  "name": "cre8",
  "version": "0.1.0",
  "private": true,
  "description": "Cre8 \u2014 a visual website builder for designers.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc -p workers/tsconfig.json && tsc -p workers/sites/tsconfig.json",
    "test": "node tests/static/run.mjs",
    "test:render": "node tests/render/run.mjs",
    "test:blocks": "node tests/render/blocks.mjs",
    "verify": "npm run typecheck && npm run test",
    "deploy": "next build && wrangler deploy",
    "deploy:sites": "wrangler deploy --config workers/sites/wrangler.jsonc",
    "preview": "next build && wrangler dev --persist-to .wrangler/state",
    "preview:sites": "wrangler dev --config workers/sites/wrangler.jsonc --port 8788 --persist-to ../../.wrangler/state",
    "db:init": "wrangler d1 execute cre8 --remote --file=./workers/schema.sql",
    "db:init:local": "wrangler d1 execute cre8 --local --file=./workers/schema.sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "immer": "^10.2.0",
    "lucide-react": "^1.30.0",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.58.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.0"
  }
}
